+fn apply_pcm_volume(data: &mut [u8], bits_per_sample: u16, channels: u16, left: u16, right: u16) {
+    if left == 0xFFFF && right == 0xFFFF {
+        return;
+    }
+    let channels = usize::from(channels.max(1));
+    let mut phase = 0usize;
+    let lane_volume = |phase: usize| -> u16 {
+        if channels == 1 {
+            left
+        } else if phase % channels == 1 {
+            right
+        } else {
+            left
+        }
+    };
+    match bits_per_sample {
+        8 => {
+            for sample in data.iter_mut() {
+                let vol = lane_volume(phase);
+                let centered = i16::from(*sample) - 128;
+                let scaled = (i32::from(centered) * i32::from(vol)) / 0xFFFF;
+                *sample = u8::try_from((scaled + 128).clamp(0, 255)).unwrap_or(0);
+                phase = phase.wrapping_add(1);
+            }
+        }
+        16 => {
+            for chunk in data.chunks_exact_mut(2) {
+                let vol = lane_volume(phase);
+                let sample = i16::from_le_bytes([chunk[0], chunk[1]]);
+                let scaled = (i32::from(sample) * i32::from(vol)) / 0xFFFF;
+                let out = i16::try_from(scaled.clamp(i32::from(i16::MIN), i32::from(i16::MAX))).unwrap_or(0);
+                let bytes = out.to_le_bytes();
+                chunk[0] = bytes[0];
+                chunk[1] = bytes[1];
+                phase = phase.wrapping_add(1);
+            }
+        }
+        _ => {}
+    }
+}
