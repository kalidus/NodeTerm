+/// After WebCodecs presents (or discards) a frame, release that many deferred
+/// FrameAcknowledge PDUs so the server can pace Adaptive Graphics.
+#[wasm_bindgen]
+pub fn acknowledge_egfx_presented(count: u32) {
+    if count == 0 {
+        return;
+    }
+    PENDING_EGFX_ACK.with(|slot| {
+        slot.set(slot.get().saturating_add(count));
+    });
+    AVC_WAKE.with(|slot| {
+        if let Some(tx) = slot.borrow().as_ref() {
+            let _ = tx.unbounded_send(());
+        }
+    });
