+fn present_pending_avc(
+    active_stage: &mut ActiveStage,
+    image: &mut DecodedImage,
+    gui: &mut Canvas,
+    draw_buffer: &mut WriteBuf,
+) -> anyhow::Result<()> {
+    let pending = PENDING_AVC.with(|queue| core::mem::take(&mut *queue.borrow_mut()));
+    for update in pending {
+        let latest = SURFACE_EPOCH.with(|epochs| epochs.borrow().get(&update.surface_id).copied());
+        if latest != Some(update.epoch) || update.right <= update.left || update.bottom <= update.top {
+            continue;
+        }
+        let dest = ironrdp_pdu::geometry::ExclusiveRectangle {
+            left: update.left,
+            top: update.top,
+            right: update.right,
+            bottom: update.bottom,
+        };
+        if let Some(mut gfx) = active_stage.get_dvc_mut::<GraphicsPipelineClient>() {
+            gfx.processor_mut()
+                .apply_external_rgba(update.surface_id, &dest, &update.rgba);
+        }
+        let region = InclusiveRectangle {
+            left: update.left,
+            top: update.top,
+            right: update.right.saturating_sub(1),
+            bottom: update.bottom.saturating_sub(1),
+        };
+        if image.apply_rgba32(&update.rgba, &region, false).is_err() {
+            continue;
+        }
+        draw_buffer.clear();
+        let painted = extract_partial_image(image, region, draw_buffer);
+        gui.draw(draw_buffer.filled_mut(), painted)
+            .context("draw avc region")?;
+        draw_buffer.clear();
+    }
+    Ok(())
+}
