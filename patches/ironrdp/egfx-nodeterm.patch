+fn flush_deferred_egfx_acks(
+    active_stage: &mut ActiveStage,
+    writer_tx: &mpsc::UnboundedSender<Vec<u8>>,
+) -> anyhow::Result<()> {
+    let count = PENDING_EGFX_ACK.with(|slot| {
+        let n = slot.get();
+        slot.set(0);
+        n
+    });
+    if count == 0 {
+        return Ok(());
+    }
+    let (channel_id, messages) = {
+        let Some(mut dvc) = active_stage.get_dvc_mut::<GraphicsPipelineClient>() else {
+            return Ok(());
+        };
+        let channel_id = dvc.channel_id();
+        let messages = dvc.processor_mut().acknowledge_presented(count);
+        (channel_id, messages)
+    };
+    if messages.is_empty() {
+        return Ok(());
+    }
+    let svc = ironrdp::dvc::encode_dvc_messages(channel_id, messages, ironrdp::svc::ChannelFlags::empty())
