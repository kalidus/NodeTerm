+const DIAG_CAPTURE_CAP: usize = 4 * 1024 * 1024;
+
+struct ResizeDiag {
+    wts2: u32,
+    clear: u32,
+    cache: u32,
+    cache_miss: u32,
+    solid: u32,
+    avc: u32,
+    progressive: u32,
+    held: u32,
+    errors: u32,
+    any: u32,
+    capture: Vec<u8>,
+    capturing: bool,
+}
+
+impl Default for ResizeDiag {
+    fn default() -> Self {
+        Self {
+            wts2: 0,
+            clear: 0,
+            cache: 0,
+            cache_miss: 0,
+            solid: 0,
+            avc: 0,
+            progressive: 0,
+            held: 0,
+            errors: 0,
+            any: 0,
+            capture: Vec::new(),
+            capturing: false,
+        }
+    }
+}
+
+thread_local! {
+    static RESIZE_DIAG: RefCell<ResizeDiag> = RefCell::new(ResizeDiag::default());
+}
+
+fn diag_with(update: impl FnOnce(&mut ResizeDiag)) {
+    RESIZE_DIAG.with(|slot| update(&mut slot.borrow_mut()));
+}
+
+fn diag_add_errors(count: u32) {
+    if count == 0 {
+        return;
+    }
+    diag_with(|diag| diag.errors = diag.errors.saturating_add(count));
+}
+
+fn diag_add_progressive() {
+    diag_with(|diag| diag.progressive = diag.progressive.saturating_add(1));
+}
+
+fn diag_add_held() {
+    diag_with(|diag| diag.held = diag.held.saturating_add(1));
+}
+
+fn diag_add_any() {
+    diag_with(|diag| diag.any = diag.any.saturating_add(1));
+}
+
+fn diag_add_wts2(bitmap: &[u8]) {
+    diag_with(|diag| {
+        diag.wts2 = diag.wts2.saturating_add(1);
+        if !diag.capturing || bitmap.is_empty() {
+            return;
+        }
+        let len = u32::try_from(bitmap.len()).unwrap_or(u32::MAX);
+        let extra = 4 + bitmap.len();
+        if diag.capture.len().saturating_add(extra) > DIAG_CAPTURE_CAP {
+            return;
+        }
+        diag.capture.extend_from_slice(&len.to_le_bytes());
+        diag.capture.extend_from_slice(bitmap);
+    });
+}
+
+/// Start a resize window: counters and the progressive byte capture reset.
+pub fn egfx_diag_begin() {
+    diag_with(|diag| {
+        *diag = ResizeDiag::default();
+        diag.capturing = true;
+    });
+}
+
+/// Current Progressive soft-fail count without clearing the resize window.
+pub fn egfx_diag_error_count() -> u32 {
+    RESIZE_DIAG.with(|slot| slot.borrow().errors)
+}
+
+/// Counters since [`egfx_diag_begin`], plus the captured progressive payloads.
+///
+/// `altSign` stays 0: this build does not change or probe the DAS sign formula.
+pub fn egfx_diag_take() -> (String, Vec<u8>) {
+    RESIZE_DIAG.with(|slot| {
+        let diag = std::mem::take(&mut *slot.borrow_mut());
+        let painted = if diag.progressive == 0 {
+            100
+        } else {
+            diag.progressive.saturating_sub(diag.held).saturating_mul(100) / diag.progressive
+        };
+        let any_codec = if diag.any > 0 || diag.clear > 0 || diag.solid > 0 || diag.cache > 0 || diag.avc > 0 {
+            100
+        } else {
+            0
+        };
+        let summary = format!(
+            r#"{{"painted":{painted},"anyCodec":{any_codec},"unclean":{},"altSign":0,"held":{},"errors":{},"cacheMiss":{},"pdus":"wts2:{},clear:{},cache:{},solid:{},avc:{}"}}"#,
+            diag.held, diag.held, diag.errors, diag.cache_miss, diag.wts2, diag.clear, diag.cache, diag.solid, diag.avc
+        );
+        (summary, diag.capture)
+    })
+}
