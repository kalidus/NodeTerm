+    /// Fit the previous framebuffer into a new `ResetGraphics` size.
+    ///
+    /// A same-size reset still zero-fills via [`Self::reset_preserving_pointer`].
+    /// A real size change scales the old pixels in, so the strip the server does
+    /// not replay is the previous desktop instead of black, and a shrink does not
+    /// keep the old taskbar below the new one.
+    pub(crate) fn resize_scaled(&mut self, width: u16, height: u16) -> SessionResult<()> {
+        if width == self.width && height == self.height {
+            return self.reset_preserving_pointer(width, height);
+        }
+        let bpp = self.pixel_format.bytes_per_pixel();
+        let old_w = usize::from(self.width);
+        let old_h = usize::from(self.height);
+        let old = if bpp == 4 && old_w > 0 && old_h > 0 {
+            Some(self.data.clone())
+        } else {
+            None
+        };
+        self.reset_preserving_pointer(width, height)?;
+        let Some(old) = old else {
+            return Ok(());
+        };
+        let new_w = usize::from(width);
+        let new_h = usize::from(height);
+        if new_w == 0 || new_h == 0 {
+            return Ok(());
+        }
+        for y in 0..new_h {
+            let sy = y * old_h / new_h;
+            for x in 0..new_w {
+                let sx = x * old_w / new_w;
+                let src = (sy * old_w + sx) * 4;
+                let dst = (y * new_w + x) * 4;
+                if src + 4 <= old.len() && dst + 4 <= self.data.len() {
+                    self.data[dst..dst + 4].copy_from_slice(&old[src..src + 4]);
+                }
+            }
+        }
+        Ok(())
+    }
