+async fn open_reliable_udp(
+    destination: &str,
+    request: &ironrdp::pdu::rdp::multitransport::MultitransportRequestPdu,
+    soft_sync: bool,
+) -> connector::ConnectorResult<connector::MultitransportResult> {
+    use connector::MultitransportResult;
+    use ironrdp::pdu::rdp::multitransport::{MultitransportResponsePdu, RequestedProtocol};
+
+    info!(soft_sync, request_id = request.request_id, "Initiate Multitransport Request");
+
+    if request.requested_protocol != RequestedProtocol::UdpFecR {
+        warn!("multitransport lossy (DTLS) rechazado; la sesion sigue por TCP");
+        return Ok(MultitransportResult::Failure(MultitransportResponsePdu::E_ABORT));
+    }
+
+    let callback = UDP_OPEN_CALLBACK.with(|slot| slot.borrow().clone());
+    let Some(callback) = callback else {
+        warn!("sin callback UDP; la sesion sigue por TCP");
+        return Ok(MultitransportResult::Failure(MultitransportResponsePdu::E_ABORT));
+    };
+
+    let args = js_sys::Array::new();
+    args.push(&JsValue::from_str(destination));
+    args.push(&JsValue::from(request.request_id));
+    args.push(&js_sys::Uint8Array::from(request.security_cookie.as_slice()));
+    let invoked = callback.apply(&JsValue::NULL, &args);
+    let Ok(invoked) = invoked else {
+        warn!("el callback UDP lanzo un error; la sesion sigue por TCP");
+        return Ok(MultitransportResult::Failure(MultitransportResponsePdu::E_ABORT));
+    };
+    let value = match invoked.dyn_into::<js_sys::Promise>() {
+        Ok(promise) => match wasm_bindgen_futures::JsFuture::from(promise).await {
+            Ok(value) => value,
+            Err(error) => {
+                warn!("apertura UDP fallida: {error:?}");
+                return Ok(MultitransportResult::Failure(MultitransportResponsePdu::E_ABORT));
+            }
+        },
+        Err(value) => value,
+    };
+    if value.is_truthy() {
+        info!("tunel UDP fiable establecido");
+        UDP_READY.with(|flag| flag.set(true));
+        Ok(MultitransportResult::Success)
+    } else {
+        warn!("tunel UDP no disponible; la sesion sigue por TCP");
+        Ok(MultitransportResult::Failure(MultitransportResponsePdu::E_ABORT))
+    }
+}
