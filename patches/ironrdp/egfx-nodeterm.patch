+struct PendingAvcRect {
+    epoch: u32,
+    surface_id: u16,
+    left: u16,
+    top: u16,
+    right: u16,
+    bottom: u16,
+    rgba: Vec<u8>,
+}
+
+thread_local! {
+    static AVC_EPOCH: Cell<u32> = const { Cell::new(0) };
+    static SURFACE_EPOCH: RefCell<std::collections::BTreeMap<u16, u32>> =
+        const { RefCell::new(std::collections::BTreeMap::new()) };
+    static PENDING_AVC: RefCell<Vec<PendingAvcRect>> = const { RefCell::new(Vec::new()) };
+    static AVC_WAKE: RefCell<Option<mpsc::UnboundedSender<()>>> = const { RefCell::new(None) };
+    /// How many deferred FrameAcknowledge PDUs JS wants flushed.
+    static PENDING_EGFX_ACK: Cell<u32> = const { Cell::new(0) };
+}
+
+fn bump_avc_epoch() -> u32 {
+    AVC_EPOCH.with(|epoch| {
+        let next = epoch.get().wrapping_add(1).max(1);
+        epoch.set(next);
+        next
+    })
+}
+
+/// Epoch estable por superficie. Varios bitmaps del mismo frame tienen que
+/// pintarse todos: subir el epoch en cada bitstream tira la imagen y deja
+/// el canvas en negro cuando el servidor manda solo H.264.
+fn current_avc_epoch(surface_id: u16) -> u32 {
+    SURFACE_EPOCH.with(|epochs| {
+        let mut map = epochs.borrow_mut();
+        if let Some(epoch) = map.get(&surface_id).copied() {
+            return epoch;
+        }
+        let next = bump_avc_epoch();
+        map.insert(surface_id, next);
+        next
+    })
+}
+
+fn invalidate_avc_epochs() {
+    let _ = bump_avc_epoch();
+    SURFACE_EPOCH.with(|epochs| epochs.borrow_mut().clear());
+    PENDING_AVC.with(|queue| queue.borrow_mut().clear());
+}
+
+/// GPU decoder writes one exclusive rectangle back into the EGFX framebuffer.
+/// Stale epochs (a newer bitstream already arrived) are dropped.
+#[wasm_bindgen]
+pub fn apply_egfx_rgba(
+    epoch: u32,
+    surface_id: u16,
+    left: u16,
+    top: u16,
+    right: u16,
+    bottom: u16,
+    rgba: &[u8],
+) {
+    let latest = SURFACE_EPOCH.with(|epochs| epochs.borrow().get(&surface_id).copied());
+    if latest != Some(epoch) || rgba.is_empty() || right <= left || bottom <= top {
+        return;
+    }
+    PENDING_AVC.with(|queue| {
+        queue.borrow_mut().push(PendingAvcRect {
+            epoch,
+            surface_id,
+            left,
+            top,
+            right,
+            bottom,
+            rgba: rgba.to_vec(),
+        });
+    });
+    AVC_WAKE.with(|slot| {
+        if let Some(tx) = slot.borrow().as_ref() {
+            let _ = tx.unbounded_send(());
+        }
+    });
+}
